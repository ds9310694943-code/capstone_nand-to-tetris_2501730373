// Memory.hdl - RAM16K (0-16383), Screen (16384-24575), Keyboard (24576)
// Roll No 2501730373, K = 73
CHIP Memory {
    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    // address[14]=0 -> RAM16K ; address[14]=1 -> Screen / Keyboard
    DMux(in=load, sel=address[14], a=ramLoad, b=ioLoad);

    RAM16K(in=in, load=ramLoad, address=address[0..13], out=ramOut);
    Screen(in=in, load=ioLoad, address=address[0..12], out=screenOut);
    Keyboard(out=keyOut);

    // address[13]=0 -> Screen ; address[13]=1 -> Keyboard
    Mux16(a=screenOut, b=keyOut, sel=address[13], out=ioOut);
    Mux16(a=ramOut, b=ioOut, sel=address[14], out=out);
}
